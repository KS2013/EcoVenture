{
  "name": "ecoventure",
  "version": "1.0.6-beta",
  "description": "Mobile and desktop app for recording litter disposal in exchange for reward points",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed"
  },
  "build": {
    "appId": "com.ecoventure.app",
    "productName": "EcoVenture",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@supabase/supabase-js": "^2.87.1",
    "electron-store": "^5.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "electron-playwright-helpers": "^2.1.0",
    "playwright": "^1.57.0",
    "serve": "^14.2.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muiznaveedrana/EcoVenture.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/muiznaveedrana/EcoVenture/issues"
  },
  "homepage": "https://github.com/muiznaveedrana/EcoVenture#readme"
}
